# AgriResolve AI - environment template.
# Copy to .env and fill in real values. .env is git-ignored: never commit it.

# ---- PostgreSQL ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agriresolve
DB_USER=agriresolve_app
DB_PASSWORD=change-me

# ---- Google Earth Engine ----
# Not configured yet in this project. See docs/api_setup.md.
GEE_PROJECT_ID=your-gee-project-id
GEE_SERVICE_ACCOUNT=your-service-account@your-project.iam.gserviceaccount.com
GEE_PRIVATE_KEY_PATH=./secrets/gee-key.json

# ---- Google APIs (Maps JavaScript / Routes / Weather) ----
# Not configured yet in this project. See docs/api_setup.md.
GOOGLE_MAPS_API_KEY=your-restricted-key
GOOGLE_ROUTES_API_KEY=your-restricted-key
GOOGLE_WEATHER_API_KEY=your-restricted-key

# ---- Ollama (local LLM) ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ---- App ----
APP_ENV=development
